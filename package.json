{
  "name": "openaid-protocol",
  "version": "0.1.0",
  "description": "Decentralized charitable procurement and staged settlement protocol",
  "private": true,
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:contracts": "hardhat test test/OpenAidEscrow.test.ts",
    "test:deployment": "hardhat test test/deployment.test.ts",
    "test:arkiv": "mocha -r ts-node/register test/arkiv.test.ts",
    "test:cre": "mocha -r ts-node/register test/cre.test.ts",
    "test:worldid": "mocha -r ts-node/register test/worldid.test.ts",
    "test:arc": "mocha -r ts-node/register test/arc-integration.test.ts",
    "test:all": "npm run test:contracts && npm run test:deployment && npm run test:arc && npm run test:arkiv && npm run test:cre && npm run test:worldid",
    "verify:token": "hardhat run scripts/verify-token.ts",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "deploy:arc": "hardhat run scripts/deploy.ts --network arcTestnet",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "@arkiv-network/sdk": "^1.0.1",
    "@openzeppelin/contracts": "^5.0.2",
    "@worldcoin/idkit": "^1.3.0",
    "@worldcoin/idkit-core": "^1.3.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.395.0",
    "next": "14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.3.0",
    "viem": "^2.57.16"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.7",
    "@nomicfoundation/hardhat-ethers": "^3.0.6",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.11",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.8",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.16",
    "@types/mocha": "^10.0.7",
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "chai": "^4.4.1",
    "dotenv": "^18.0.9",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.5",
    "ethers": "^6.13.1",
    "hardhat": "^2.22.6",
    "postcss": "^8.4.39",
    "solidity-coverage": "^0.8.12",
    "tailwindcss": "^3.4.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.16.2",
    "typechain": "^8.3.2",
    "typescript": "^5.5.2"
  }
}
