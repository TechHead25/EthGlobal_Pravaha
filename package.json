{
  "name": "openaid-protocol",
  "version": "0.1.0",
  "description": "Decentralized charitable procurement and staged settlement protocol",
  "private": true,
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:contracts": "hardhat test test/OpenAidEscrow.test.ts",
    "test:deployment": "hardhat test test/deployment.test.ts",
    "test:arkiv": "mocha -r ts-node/register test/arkiv.test.ts",
    "test:cre": "mocha -r ts-node/register test/cre.test.ts",
    "test:worldid": "mocha -r ts-node/register test/worldid.test.ts",
    "test:validator": "mocha -r ts-node/register test/validator-selection.test.ts",
    "test:partners": "npm run test:arc && npm run test:arkiv && npm run test:cre && npm run test:worldid && npm run test:validator",
    "test:arc": "mocha -r ts-node/register test/arc-integration.test.ts",
    "test:all": "npm run test:contracts && npm run test:deployment && npm run test:arc && npm run test:arkiv && npm run test:cre && npm run test:worldid && npm run test:auth",
    "verify:token": "hardhat run scripts/verify-token.ts",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "deploy:arc": "hardhat run scripts/deploy.ts --network arcTestnet",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:auth": "mocha -r ts-node/register test/auth-rbac.test.ts test/auth-security.test.ts test/wallet-tx.test.ts test/escrow-dashboards.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "seed:arkiv": "tsx scripts/seed-arkiv.ts",
    "admin:grant": "tsx scripts/grant-admin.ts",
    "test:db": "mocha -r ts-node/register test/prisma-store.integration.test.ts"
  },
  "dependencies": {
    "@arkiv-network/sdk": "^1.0.1",
    "@hookform/resolvers": "3.10.0",
    "@openzeppelin/contracts": "^5.0.2",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-avatar": "1.1.10",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-label": "2.1.7",
    "@radix-ui/react-slot": "1.2.3",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-tooltip": "1.2.8",
    "@tanstack/react-table": "8.21.3",
    "@worldcoin/idkit": "^1.3.0",
    "@worldcoin/idkit-core": "^1.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "11.18.2",
    "lucide-react": "^0.395.0",
    "next": "14.2.5",
    "next-auth": "5.0.0-beta.29",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "7.62.0",
    "recharts": "2.15.4",
    "server-only": "0.0.1",
    "sonner": "2.0.7",
    "tailwind-merge": "^2.3.0",
    "viem": "^2.57.16",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.7",
    "@nomicfoundation/hardhat-ethers": "^3.0.6",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.11",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.8",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.16",
    "@types/mocha": "^10.0.7",
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "chai": "^4.4.1",
    "dotenv": "^18.0.9",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.5",
    "ethers": "^6.13.1",
    "hardhat": "^2.22.6",
    "postcss": "^8.4.39",
    "prisma": "6.19.3",
    "solidity-coverage": "^0.8.12",
    "tailwindcss": "^3.4.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.16.2",
    "typechain": "^8.3.2",
    "typescript": "^5.5.2"
  }
}
