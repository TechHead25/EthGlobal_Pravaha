# ==============================================================================
# OpenAid Protocol — Environment Configuration Template
# Copy this file to .env or .env.local for local development.
# NEVER commit .env or any file containing private keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Network & RPC Configuration
# ------------------------------------------------------------------------------
# Local Hardhat Node RPC (default: http://127.0.0.1:8545)
LOCAL_RPC_URL="http://127.0.0.1:8545"

# Arc Testnet (Circle Layer 1 - Chain ID: 5042002)
# Official Docs: https://docs.arc.network/
# Primary RPC: https://rpc.testnet.arc.network
# Fast Alternative RPC: https://arc-testnet.drpc.org
ARC_TESTNET_RPC_URL="https://rpc.testnet.arc.network"
ARC_TESTNET_CHAIN_ID="5042002"

# ------------------------------------------------------------------------------
# Deployment & Signer Credentials (NEVER USE REAL MAINNET OR FUNDED KEYS HERE)
# ------------------------------------------------------------------------------
# Deployer private key for Arc Testnet (32-byte hex string without secrets)
# Leave empty or set locally in uncommitted .env
DEPLOYER_PRIVATE_KEY=""

# ------------------------------------------------------------------------------
# Arc Testnet Token & Validator Configuration
# ------------------------------------------------------------------------------
# Arc Testnet external USDC token address (ERC-20 interface)
# Official Arc ERC-20 USDC: 0x3600000000000000000000000000000000000000
ARC_USDC_TOKEN_ADDRESS=""

# Five distinct, verified validator addresses required for remote deployment
VALIDATOR_1=""
VALIDATOR_2=""
VALIDATOR_3=""
VALIDATOR_4=""
VALIDATOR_5=""

# Optional: Set to "true" only when intentionally replacing an existing deployment record
OVERWRITE_DEPLOYMENT="false"

# ------------------------------------------------------------------------------
# Protocol Contract Addresses (Public frontend variables for Vercel & Local)
# ------------------------------------------------------------------------------
# Chain ID for Arc Testnet (must be 5042002)
NEXT_PUBLIC_CHAIN_ID="5042002"
NEXT_PUBLIC_ARC_CHAIN_ID="5042002"

# Public Arc Testnet RPC Endpoint
NEXT_PUBLIC_RPC_URL="https://rpc.testnet.arc.network"
NEXT_PUBLIC_ARC_RPC_URL="https://rpc.testnet.arc.network"

# Official Arc Testnet USDC ERC-20 interface (6 decimals)
NEXT_PUBLIC_USDC_ADDRESS="0x3600000000000000000000000000000000000000"

# Deployed OpenAidEscrow contract address on Arc Testnet
NEXT_PUBLIC_ESCROW_ADDRESS="0xa69d35e8f64b733c1a3f290d2152026DaaCFe00B"

# ArcScan Block Explorer URL
NEXT_PUBLIC_BLOCK_EXPLORER="https://testnet.arcscan.app"

# ------------------------------------------------------------------------------
# Arkiv Decentralized Database (Rabdi Testnet — Chain ID: 7794095)
# Official Docs: https://docs.arkiv.network/
# Explorer: https://rabdi.explorer.arkiv.network
# ------------------------------------------------------------------------------
# Arkiv target testnet identifier
ARKIV_NETWORK="rabdi"
ARKIV_CHAIN_ID="7794095"

# Primary RPC for querying and sending transactions to Arkiv Rabdi testnet
ARKIV_RPC_URL="https://rpc.rabdi.db-chain.testnet.arkiv.network"
NEXT_PUBLIC_ARKIV_RPC_URL="https://rpc.rabdi.db-chain.testnet.arkiv.network"

# Optional Arkiv Access Key for rate-limit acceleration (free at https://hub.arkiv.network/access-keys)
ARKIV_ACCESS_KEY=""
NEXT_PUBLIC_ARKIV_ACCESS_KEY=""

# Public Arkiv Rabdi Explorer URL
NEXT_PUBLIC_ARKIV_EXPLORER="https://rabdi.explorer.arkiv.network"

# Optional: Server-side signing key (32-byte hex) if executing server-assisted Arkiv writes.
# Browser client writes are signed directly via injected Web3 wallet (MetaMask).
ARKIV_SERVER_SIGNER_KEY=""

# Set to "true" to run unit tests against in-memory mock or "false" for live network queries
ARKIV_MOCK_MODE="false"

# Set to "true" to enable live network roundtrip tests during `npm run test:arkiv`
RUN_ARKIV_NETWORK_TESTS="false"

# ------------------------------------------------------------------------------
# IPFS & Content-Addressed Storage
# ------------------------------------------------------------------------------
PINATA_API_KEY=""
PINATA_API_SECRET=""
PINATA_JWT=""
NEXT_PUBLIC_IPFS_GATEWAY="https://gateway.pinata.cloud/ipfs/"

# ------------------------------------------------------------------------------
# World ID Verification (Optional Staging / Production App ID)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_WORLD_ID_APP_ID="app_staging_placeholder"
NEXT_PUBLIC_WORLD_ID_ACTION="verify-human-reviewer"

# ------------------------------------------------------------------------------
# Frontend & Timing Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="OpenAid Protocol"
NEXT_PUBLIC_APP_DESCRIPTION="Decentralized Charitable Procurement & Staged Settlement Protocol"
NEXT_PUBLIC_PROTOCOL_TIMING_MODE="DEMO"

# ------------------------------------------------------------------------------
# Authentication — Google OAuth via Auth.js v5 (SERVER-SIDE ONLY, never NEXT_PUBLIC_)
# Setup guide: docs/AUTH_SETUP.md
# ------------------------------------------------------------------------------
# 32+ byte random secret that encrypts the session cookie. Generate with:
#   npx auth secret      (or)   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""
# OAuth 2.0 Web client from Google Cloud Console → APIs & Services → Credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Required for self-hosted production (next start behind a proxy). Not needed on Vercel or in `next dev`.
# Either trust the forwarded Host header from your proxy, or pin the canonical URL:
AUTH_TRUST_HOST=""
# AUTH_URL="https://your-production-domain.example"

# ------------------------------------------------------------------------------
# Application database — PostgreSQL (users, roles, organizations, audit log)
# Stores no funds, keys, OAuth tokens, or World ID proofs.
# ------------------------------------------------------------------------------
DATABASE_URL=""
# Optional: disposable, migrated database used ONLY by `npm run test:db` (all rows are deleted)
TEST_DATABASE_URL=""

# ------------------------------------------------------------------------------
# World ID — server-side verification for validators (overrides NEXT_PUBLIC_ values)
# ------------------------------------------------------------------------------
WORLD_ID_APP_ID=""
WORLD_ID_ACTION=""
# "orb" (default) or "device"
WORLD_ID_MINIMUM_LEVEL=""

# ------------------------------------------------------------------------------
# Optional public footer links (rendered only when set)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPPORT_URL=""
NEXT_PUBLIC_SECURITY_CONTACT_URL=""
NEXT_PUBLIC_SOCIAL_URL=""
